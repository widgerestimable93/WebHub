<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WebHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryDark">@color/primary_navy</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/primary_navy</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/primary_navy</item>
    </style>

    <style name="Theme.WebHub.Splash">
        <item name="android:windowBackground">@color/primary_navy</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/primary_navy</item>
    </style>

    <style name="ShapeAppearance.WebHub.IconCorner" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>

